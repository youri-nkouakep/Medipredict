# Copy to .env and fill in. Never commit the .env file.

# JWT signing key. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me

# Local run without MySQL: a SQLite file is enough
DATABASE_URL=sqlite:///./medipredict.db
# With MySQL: DATABASE_URL=mysql+pymysql://medipredict:password@localhost:3306/medical_db

ACCESS_TOKEN_EXPIRE_MINUTES=60

# Used by docker compose
MYSQL_PASSWORD=change-me-too
